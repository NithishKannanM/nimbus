# Nimbus configuration. Copy to .env and edit; .env is git-ignored.
# Every key is optional -- these are the defaults from backend/config.py.

# --- backend selection -------------------------------------------------
# local  : in-process queue / store / artifacts (Phases 1-4)
# aws    : SQS / DynamoDB / S3            (implemented; never run against real AWS)
NIMBUS_BACKEND=local

# --- scheduling --------------------------------------------------------
# Implemented: fifo, static_resource_aware, static_resource_aware_binpack,
# adaptive (adaptive-v1). "priority" is not implemented and is rejected with 422.
NIMBUS_STRATEGY=adaptive
NIMBUS_SCHEDULER_TICK_S=0.02
NIMBUS_AGING_INTERVAL_S=30.0

# --- fleet -------------------------------------------------------------
NIMBUS_WORKER_COUNT=3
NIMBUS_WORKER_SLOTS=2
# Declared capacity, ECS-style units (1 vCPU = 1024). Keep >= slots * the
# largest job cpu_units, or some slots can never be filled.
NIMBUS_WORKER_CPU_UNITS=2048
NIMBUS_WORKER_MEMORY_MB=4096

# --- telemetry / health ------------------------------------------------
# Telemetry is OBSERVED state: collected, stored, exposed, and recorded in every
# decision trace. No implemented placement policy can read it -- that boundary
# is structural (scheduler/views.py), and toggling this must not change any
# placement decision. Measured overhead: ~0.13% duty cycle at a 1 s interval.
NIMBUS_TELEMETRY_ENABLED=1
# NIMBUS_TELEMETRY_INTERVAL_SECONDS is accepted as an alias.
NIMBUS_TELEMETRY_INTERVAL_S=2.0
NIMBUS_TELEMETRY_HISTORY=300
# Smoothing window for adaptive-v1's observed-CPU signal, in samples.
# CHANGING THIS CHANGES THE ALGORITHM: adaptive-v1 pre-registered it at 3, so a
# different value is a different algorithm and needs a new version identity.
NIMBUS_TELEMETRY_WINDOW=3
# Telemetry older than this is stale. adaptive-v1 then falls back to
# reservation-derived estimates for that worker -- never to "0% CPU", which
# would make the least-observed worker the most attractive one.
# NIMBUS_TELEMETRY_MAX_AGE_S is accepted as an alias.
NIMBUS_TELEMETRY_MAX_AGE_SECONDS=6.0
NIMBUS_HEARTBEAT_INTERVAL_S=5.0
NIMBUS_HEARTBEAT_TIMEOUT_S=15.0
NIMBUS_EVICTION_TIMEOUT_S=60.0

# --- reliability -------------------------------------------------------
NIMBUS_JOB_TIMEOUT_S=300.0
NIMBUS_MAX_ATTEMPTS=3
# Also the recovery bound for an orphaned job: a job whose lease the control
# plane lost cannot be made visible again without its receipt (SQS has no such
# API, and LocalJobQueue reproduces that), so it comes back only when this
# elapses. A reason to keep it short.
NIMBUS_VISIBILITY_TIMEOUT_S=60.0

# How often the reaper sweeps for the failures that produce no event at all:
# a job past its timeout, a job on a worker that stopped heartbeating, a job
# live in the store with nobody holding its lease. Bounds detection latency, so
# keep it well below NIMBUS_HEARTBEAT_TIMEOUT_S.
NIMBUS_REAPER_INTERVAL_S=2.0
# A job in SCHEDULED/RUNNING with no lease is only "orphaned" once it has been
# that way longer than any legitimate gap between control-plane steps. Too low
# and the reaper races the dispatch path and re-places running jobs.
NIMBUS_ORPHAN_GRACE_S=30.0

# Retry backoff: min(base * 2**(n-1), cap), minus deterministic jitter.
# The jitter is a function of (job_id, attempt), not a global RNG, so two runs
# of the same seeded profile cannot diverge on retry timing -- which would
# perturb a strategy comparison for reasons unrelated to the scheduler.
NIMBUS_RETRY_BASE_S=0.5
NIMBUS_RETRY_CAP_S=30.0
NIMBUS_RETRY_JITTER_RATIO=0.25

# --- storage -----------------------------------------------------------
NIMBUS_ARTIFACT_DIR=.nimbus/artifacts

# --- experiment --------------------------------------------------------
NIMBUS_SEED=1337
# External-pressure backend for benchmark profiles B and C.
# builtin (default, no dependency) | stress-ng (more precise, version-dependent)
# NIMBUS_PRESSURE_BACKEND=builtin

# --- api ---------------------------------------------------------------
# Administrative / failure-simulation endpoints (/admin/*). When unset the
# router is NOT REGISTERED AT ALL -- and since Nimbus has no authentication
# before Phase 7, that is the entire access-control story for routes that can
# crash a worker or drain the fleet. Never enable on a public listener.
NIMBUS_ENABLE_ADMIN=0

# --- AWS (NIMBUS_BACKEND=aws only; never commit real values) -----------
# Resource ADDRESSES only. There is deliberately no credential field in
# NimbusConfig at all: on EC2 credentials come from the instance profile and
# locally from the standard boto3 chain, so there is no path by which a key
# could reach a config file, a log line, or a benchmark manifest.
# `terraform output -raw nimbus_env` prints this block filled in.
#
# Requires: pip install -r requirements-aws.txt
#
# NIMBUS_BACKEND=aws
# NIMBUS_AWS_REGION=us-east-1
# NIMBUS_SQS_QUEUE_URL=
# Without the DLQ url, dead-lettered jobs are never reconciled and stay live in
# the store forever with nothing left to deliver them. A silent stall.
# NIMBUS_SQS_DLQ_URL=
# NIMBUS_DYNAMODB_TABLE=nimbus-state
# NIMBUS_S3_BUCKET=
